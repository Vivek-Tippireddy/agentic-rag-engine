# Agentic RAG Engine - Environment Variables
# Copy this file to .env and fill in your API keys / tokens

# 1. Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# 2. Hugging Face Access Token (Optional - for HF Hub / Inference Endpoints)
HF_TOKEN=

# 3. OpenAI API Key (Optional)
OPENAI_API_KEY=

# 4. Default Data Directory Path
DATA_DIR=C:\Users\tippi\OneDrive\Desktop\Agentic RAG for NLP poster\data
